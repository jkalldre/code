int main()
{
   char fileName[256];
   char letter;
   
   cout << "Filename? ";
   cin >> fileName;

   cout << "Use the EOF method? (y/n): ";
   cin >> letter;

   if (letter == 'y' || letter == 'Y')
      usingEOF(fileName);
   else
      return 0;
}

void usingEOF(char fileName[])
{
   ifstream fin(fileName);
   if (fin.fail())
   {
      cout << "Unable to open file";
      return;
   }

   char text[256];

   while (!fin.eof())
   {
      fin >> text;
      cout << "'" << text << "' ";
   }

   cout << endl;

   fin.close();
}
   
