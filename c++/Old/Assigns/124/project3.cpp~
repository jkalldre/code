#include <iostream>
#include <fstream>
using namespace std;

void getFileName(char fileName[]);
int readFile(char fileName[], char story[][256]);
void display(char story[][256], int size);
void getWords(char story[][256], int size);

/**********************************************************************
 * main will call all the other functions and determine if the user
 * wishes to play MadLib again or end the program
 ***********************************************************************/
int main()
{
   char fileName[256];
   char story[5000][256];
   char letter;
   
   do
   {
      getFileName(fileName);
      int size = readFile(fileName, story);
      
      getWords(story, size);
      
      if (size != -1)
         display(story, size);

      cout << "Do you want to play again (y/n)? ";
      cin >> letter;

      if (letter == 'n' || letter == 'N')
         cout << "Thank you for playing." << endl;
   }
   while (letter != 'n' || letter == 'N');
      
   return 0;
}

/**********************************************************************
 * getFileName will prompt user for a madlib file to read
  ***********************************************************************/
void getFileName(char fileName[])
{
   cout << "Please enter the filename of the Mad Lib: ";
   cin >> fileName;
   cin.ignore();
   
   return;
}

/**********************************************************************
 * readFile will use the fileName given
 * 
 ***********************************************************************/
int readFile(char fileName[], char story[][256])
{
   int i = 0;
   ifstream fin(fileName);
   
   if (fin.fail())
      return -1;

   while (fin >> story[i])
      i++;

   fin.close();
   return i;
}

void display(char story[][256], int size)
{
   cout << endl;
   
   for (int i = 0; i < size; i++)
   {
      if (ispunct(story[i+1][0])
          || i == size -1
          || story[i][0] == '\n'
          || story[i+1][0] == '\n'
          || story[i][1] == '\''
          || story[i+1][1] == '\''
          || story[i+1][0] == '\''
          || story[i][1] == '\"'
          || story[i+1][1] == '\"')

         cout << story[i];
      
      else
         cout << story[i] << " ";
   }
           
   
   cout << endl;
   return;
}

void getWords(char story[][256], int size)
{
   for (int i = 0; i < size; i++)
      if (story[i][0] == '<')
      {
         switch (story[i][1])
         {
            case '#':
               story[i][0] = '\n';
               story[i][1] = 0;
               break;
            case '{':
               story[i][0] = ' ';
               story[i][1] = '\"';
               story[i][2] = 0;
               break;
            case '}':
               story[i][0] = '\"';
               story[i][1] = 0;
               break;
            case '[':
               story[i][0] = ' ';
               story[i][1] = '\'';
               story[i][2] = 0;
               break;
            case ']':
               story[i][0] = '\'';
               story[i][1] = 0;
               break;
            default:
               int j;
               for (j = 1; story[i][j] != '>'; j++)
               {
                  if (story[i][j] == '_')
                     story[i][j-1] = ' ';
                  else
                     story[i][j-1] = story[i][j];
               }
               story[i][j-1] = 0;
               story[i][0] = toupper(story[i][0]);
               cout << "\t" << story[i] << ": ";
               cin.getline(story[i],256);
               
         }

      }
   return;
}
