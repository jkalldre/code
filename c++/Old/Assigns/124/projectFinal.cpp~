      {
         for (i = 0; i < 10; i++)
         {
            bool oK = checkSquare(board, x, y, i, input);
            if (oK == true)
            {
               count++;
               value = i;
            }
         }
            if (count == 1)
            {
               board[y][x] = value;
               count = 0;
               x = 0;
               y = 0;
               
            }
            else
               count = 0;
            
         
      }
   
   cout << endl << endl;
