            }
            else
               cout << " " << board[cY][cX] << "|";
         }
         
         else
         {
            if (cX == 3)
            {
               if (board[cY][cX] == 0)
                  cout << "  ";
               else
                  cout << board[cY][cX];
            }
            
            else if (cX == 6)
            {
               if (board[cY][cX] == 0)
                  cout << " ";
               else
                  cout << board[cY][cX];
            }
            
            else
            {
               if (board[cY][cX] == 0)
                  cout << "  ";
               else
               {

                  if (cX == 4)
                  {
                     if (board[cY][cX - 1] != 0)
                        cout << " " << board[cY][cX];
                     else
                        cout << board[cY][cX];
                  }
                  else
                     cout << " " << board[cY][cX];
               }
            }
         }
      }
      
      cout << endl;
      
      if (cY == 2 || cY == 5)
         cout << "   -----+-----+-----\n";
   }
   
   cout << endl;
   
