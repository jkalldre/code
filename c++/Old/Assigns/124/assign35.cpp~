#include <iostream>
using namespace std;

int computeLetterGrade(int grade);
int computeGradeSign(int grade);

/**********************************************************************
 * Add text here to describe what the function "main" does. Also don't forget
 * to fill this out with meaningful text or YOU WILL LOSE POINTS.
 ***********************************************************************/
int main()
{
   int grade = 0;
   
   cout << "Enter number grade: ";
   cin >> grade;
   
   char letter = computeLetterGrade(grade);
   char sign = computeGradeSign(grade);

   switch (letter)
   {
      case 'A':
         cout << grade << "% is " << letter
              << ((sign == '+') ? endl : sign << endl;
         break;
      case 'F':
         cout << grade << "% is " << letter << endl;
   }
   return 0;
}

int computeLetterGrade(int grade)
{
   switch (grade / 10)
   {
      case 10:
      case 9:
         return 'A';
         break;
         
      case 8:
         return 'B';
         break;
         
      case 7:
         return 'C';
         break;
         
      case 6:
         return 'D';
         break;
         
      default:
         return 'F';
   }
}

int computeGradeSign(int grade)
{
   switch (grade % 10)
   {
      case 1:
      case 2:
         return '-';
         break;
         
      case 3:   
      case 4:
      case 5:
      case 6:
      case 7:
         return '*';
         break;
         
      default:
         return '+';
   }
   
}
