#include <iostream>
#include <iomanip>
using namespace std;

/**********************************************************************
 * Add text here to describe what the function "main" does. Also don't forget
 * to fill this out with meaningful text or YOU WILL LOSE POINTS.
 ***********************************************************************/
int main()
{
   float dollarAmount;
   int cents;
   
   // prompt user for dollar amount
   cout << endl;
   cout << "=======================================================\n";
   cout << "Please enter a positive dollar amount (ex:123.45):$ ";
   cin >> dollarAmount;
   cout << endl;
   
   // convert to cents
   cents = (dollarAmount) * 100.00;

   // Show user bill options
   cout << "Here are some possible bill amounts...\n";
   cout << endl;
   
   // to dollars
   cout << "\t$" << setw(7) << "1's: "  << setw(4) << cents / 100  << endl;
   
   // to fives
   cout << "\t$" << setw(7) << "5's: "  << setw(4) << cents / 500  << endl;

   // to tens
   cout << "\t$" << setw(7) << "10's: " << setw(4) << cents / 1000 << endl;

   // to twentys
   cout << "\t$" << setw(7) << "20's: " << setw(4) << cents / 2000 << endl;
   cout << endl;
   
   // Show user change options
   cout << "Here are some possible change amounts...\n";
   cout << endl;
   
   // to quarters
   cout << "\tQuarters: "  << setw(6) << cents / 25  << endl;
   
   // to dimes
   cout << "\tDimes   : "  << setw(6) << cents / 10 << endl;

   //to nickles
   cout << "\tNickles : "  << setw(6) << cents / 5  << endl;

   // to pennies
   cout << "\tPennies : "  << setw(6) << cents << endl;
   cout << "=======================================================\n";
   cout << endl;
   
   
   return 0;
}
