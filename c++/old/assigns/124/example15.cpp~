#include <iostream>
#include <iomanip>

using namespace std;

bool qualify(double income);
bool lessQualified(double income);

/**********************************************************************
 * Add text here to describe what the function "main" does. Also don't forget
 * to fill this out with meaningful text or YOU WILL LOSE POINTS.
 ***********************************************************************/
int main()
{
   double income = 0;
   int numChildren = 0;
   double childTax = 0;

   cout.setf(ios::fixed);
   cout.setf(ios::showpoint);
   cout.precision(2);
   
   // prompt for user input
   cout << endl;
   cout << "=========================\n";
   cout << "What is your annual income? $ ";
   cin >> income;
   

   cout << "How many children do you have? ";
   cin >> numChildren;

   if (qualify(income))  
      childTax = 1000.00 * (float)numChildren;
   else if (lessQualified(income))
      childTax = 1000 - ((income - 110000.00) * .05) * (float)numChildren;
   else
      cout << "Your income is screwed up!\n"; 

   if (childTax < 0)
      childTax = 0;
   
   cout << "Child Tax Credit: $ " << childTax << endl;
   cout << "=========================\n";
   cout << endl;
   
   
   return 0;
}

bool qualify(double income)
{
   return (income < 110000.00);    
}

bool lessQualified(double income)
{
   return (income > 110000.00);
}
