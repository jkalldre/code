void getFileName(char fileName[])
{
   cout << "Please enter the filename: ";
   cin >> fileName;
   return;
}

int readFile(char fileName[], char text[][256])
{
   int i = 0;
   ifstream fin(fileName);

   if (fin.fail())
      return -1;

   while (fin >> text[i])
      i++;

   fin.close();

   return i;
}
